{
  "name": "huddle",
  "version": "1.0.0",
  "private": true,
  "description": "Huddle: an offline-first activity discovery app. Less scrolling. More living.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "check": "npm run typecheck && npm test && npm run lint",
    "import:file": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ingest/import-file.ts",
    "ingest:instagram": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ingest/instagram-cli.ts",
    "db:check": "bash scripts/check-migrations.sh",
    "ingest:sf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ingest/sf-instagram.ts",
    "hours:sf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ingest/sf-hours.ts",
    "probe:sf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ingest/sf-probe.ts",
    "ai:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ingest/ai-check.ts"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

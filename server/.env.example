# Server-side secrets for the ingestion scripts in server/ingest.
# Copy to server/.env (git-ignored). These values must never be shipped in the app.

# Supabase: needed only for --push (writing to the shared catalog).
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Bypasses row-level security.
SUPABASE_SECRET_KEY=your-secret-key

# Apify: needed only for optional Instagram discovery.
# Apify Console → Settings → API & Integrations → Personal API tokens.
APIFY_API_TOKEN=your-apify-token
# Actor to run. The default is Apify's official Instagram scraper.
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-scraper

# Optional: contact email sent with OpenStreetMap geocoding requests (npm run ingest:sf -- --geocode).
# Nominatim's usage policy asks for a way to reach you.
NOMINATIM_EMAIL=you@example.com

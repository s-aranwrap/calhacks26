# Server-side secrets for the ingestion scripts in server/ingest.
# Copy to server/.env (git-ignored). These values must never be shipped in the app.

# Supabase: needed only for --push (writing to the shared catalog).
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Bypasses row-level security.
SUPABASE_SECRET_KEY=your-secret-key

# Apify: needed only for optional Instagram discovery.
# Apify Console → Settings → API & Integrations → Personal API tokens.
APIFY_API_TOKEN=your-apify-token
# Actor to run. The default is Apify's official Instagram scraper.
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-scraper

# Optional: Google Maps opening hours for the SF places (npm run hours:sf).
# The default is Apify's popular Google Maps scraper; about 25 places per run.
APIFY_PLACES_ACTOR_ID=compass~crawler-google-places

# Optional: let an AI model read captions and flyers (npm run ingest:sf -- --ai / --images).
# FREE: Google Gemini. Get a key at https://aistudio.google.com/apikey (no card needed).
# The free tier has a daily request limit; a run that hits it continues the next day.
# Google may use free-tier requests to improve its products, so only public posts go through it.
GEMINI_API_KEY=
# GEMINI_MODEL=            # leave empty to pick the newest free Flash-Lite model automatically

# FREE and fully local: Ollama (https://ollama.com). Install, then: ollama pull gemma3:4b
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_URL=http://localhost:11434

# PAID: Claude API (pay-as-you-go, about a cent or two per run).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Which one to use when several are set: gemini, ollama or anthropic.
# If unset: Gemini if GEMINI_API_KEY is set, then Ollama if OLLAMA_MODEL is set, then Claude.
# AI_PROVIDER=gemini

# Optional: contact email sent with OpenStreetMap geocoding requests (npm run ingest:sf -- --geocode).
# Nominatim's usage policy asks for a way to reach you.
NOMINATIM_EMAIL=you@example.com
